# Copy this file to application usage as real environment variables (do NOT commit real secrets).

# Database (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_interview_simulator
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret_value
JWT_EXPIRATION_MS=86400000

# OpenAI
OPENAI_API_KEY=your_api_key_here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Set to false to require a real OPENAI_API_KEY and disable mock responses
AI_MOCK_MODE=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Sign-In (OAuth 2.0 Client ID, NOT an API key)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
